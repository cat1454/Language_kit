# Local development database. Copy this file to .env before running migrations.
# scripts/backup-db.sh also reads DATABASE_URL from the current shell environment.
DATABASE_URL=postgres://language_kit:language_kit@localhost:54320/language_kit_dev

# Optional host port override for the Docker Compose PostgreSQL service.
POSTGRES_HOST_PORT=54320
NEXT_PUBLIC_APP_NAME=Language Kit

# Developer-only local STT prototype. It is disabled by default and disconnected
# from learner UI/API routes. Never place credentials or inline arguments here.
LANGUAGE_KIT_LOCAL_STT_ENABLED=0
LANGUAGE_KIT_LOCAL_STT_COMMAND=
